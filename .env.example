# Copy to gemini_api_key.env (or .env) and fill in. Never commit the real file.
GEMINI_API_KEY=
# gemini (cloud, fast) or comfy (local FLUX.1 Kontext via ComfyUI)
DRESSER_BACKEND=gemini
COMFY_URL=http://127.0.0.1:8188
# Required in production (32+ bytes)
JWT_SECRET=
ALLOW_REGISTRATION=true
INVITE_CODE=

# --- Hosting ---------------------------------------------------------------
# Leave these empty to run everything locally off the disk, as before.

# Postgres for the hosted database. Neon hands you a URL starting with
# "postgresql://"; SQLAlchemy needs the async driver, so change that one word to
# "postgresql+asyncpg://" and drop any "?sslmode=require" (asyncpg rejects it).
DATABASE_URL=

# local = write under media/ and serve it from /media
# s3    = write to the bucket below, which is what a hosted instance must use,
#         because its disk is wiped on every redeploy
STORAGE_BACKEND=local
R2_BUCKET=
# The S3 API endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# What the browser fetches: the bucket's PUBLIC domain, not the endpoint above.
# Enable public access on the bucket to get it, e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=
